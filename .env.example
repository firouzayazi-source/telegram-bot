# این فایل را کپی کنید به .env و مقداردهی کنید — هرگز .env واقعی را کامیت نکنید.

# ── بات تلگرام (اجباری) ──────────────────────────
BOT_TOKEN=
ADMIN_ID=

# ── پنل وب (اجباری) ──────────────────────────────
# بدون این، پنل وب اصلاً بالا نمی‌آید. رمز قوی بگذارید — پنل روی اینترنت باز است.
WEB_PASSWORD=
# نام کاربری ورود به پنل (پیش‌فرض: admin)
PANEL_USER=admin
# کلید امضای کوکی — اگر ست نشود با هر ری‌استارت از پنل خارج می‌شوید.
# ساخت: openssl rand -hex 32
PANEL_SECRET=

# ── شبکه پنل وب (اختیاری) ────────────────────────
# روی وی‌پی‌اس مشترک، یک پورت اختصاصی و آزاد برای این پروژه انتخاب کنید.
WEB_PORT=8471
WEB_HOST=0.0.0.0
