# این فایل را کپی کنید به .env و مقداردهی کنید — هرگز .env واقعی را کامیت نکنید.

# ── بات تلگرام (اجباری) ──────────────────────────
BOT_TOKEN=
ADMIN_ID=

# ── ووکامرس (اجباری) ─────────────────────────────
WOO_URL=https://stland.ir
WOO_KEY=
WOO_SECRET=

# ── پنل وب (اجباری) ──────────────────────────────
WEB_PASSWORD=

# ── ووکامرس (اختیاری) ────────────────────────────
WOO_CACHE_TTL=3600
WOO_HIDE_OOS=1

# ── شبکه پنل وب (اختیاری) ────────────────────────
# روی وی‌پی‌اس مشترک، یک پورت اختصاصی و آزاد برای این پروژه انتخاب کنید.
WEB_PORT=8471
WEB_HOST=0.0.0.0
